# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# typescript
*.tsbuildinfo
next-env.d.ts

# Detached host dev-server logs (npm run host:up)
/.host-servers/

# synclair — per-developer state for the session brief's change feed.
# NEVER committed: "what I last saw" is personal. Sharing one cursor would mean
# whoever ran the brief first silently consumed everyone else's notifications.
/data/.local/

# Derived cache — rebuilt by `npm run index`; never committed (north-star Phase 1)
.synclair/
