    "check:anchors-selftest": "synclair check-anchors-selftest",
    "check:edges": "synclair check-edges",
    "check:brief-feed": "synclair check-brief-feed",
    "check:contracts": "synclair check-contracts",
    "install:hooks": "synclair install-hooks",
    "install:agent-hooks": "synclair install-agent-hooks",
    "brief": "synclair agent-brief",
    "impact": "synclair impact",
    "status": "synclair status",
    "scan:pages": "synclair scan-pages",
    "scan:system": "synclair scan-system",
    "scan:contracts": "synclair scan-contracts",
    "map:pages": "npm run scan:pages && npm run resolve:pages && npm run check:pages -- --reanchor",
    "resolve:pages": "synclair resolve-page-items",
    "host:status": "synclair host-servers status",
    "host:up": "synclair host-servers up",
    "call-home": "synclair call-home",
    "measure:agent-cost": "synclair measure-agent-cost",
    "gen:agents-block": "synclair gen-agents-block",
    "gen:plugin-manifest": "synclair gen-plugin-manifest",
    "mcp": "synclair mcp-server",
    "mcp:probe": "synclair mcp-server --probe",
    "check:mcp-contract": "synclair check-mcp-contract",
    "check:mcp": "synclair check-mcp-registration",
    "mcp:install": "synclair mcp-install",
    "bridge:agents": "synclair bridge-agents",
    "check:agent-bridge": "synclair bridge-agents --check",
    "verify-ui": "npm run typecheck && npm run lint && npm run check:registry && npm run check:previews && npm run check:tiering && npm run check:recipes && npm run check:ux-docs && npm run check:purity && npm run check:reset-safe && npm run check:form-defaults && npm run check:pages && npm run check:knowledge-local && npm run check:edges && npm run check:brief-feed && npm run check:contracts && npm run check:anchors-selftest && npm run check:pages-selftest && npm run check:rulings-selftest && npm run check:artifacts-selftest && npm run check:augment && npm run check:agent-bridge && npm run resolve:pages -- --check && npm run check:host && npm run scan:system -- --check && npm run audit:mcp && npm run check:freshness -- --strict",
    "postinstall": "patch-package",
    "dev:bare": "next dev",
    "index": "synclair index",
    "smoke": "synclair smoke",
    "audit:mcp": "synclair audit-mcp",
    "check:discovery": "synclair check-discovery",
    "check:reset-safe": "synclair check-reset-safe",
    "check:form-defaults": "synclair check-form-defaults",
    "check:pages-selftest": "synclair check-pages-selftest",
    "check:artifacts-selftest": "synclair check-artifacts-selftest"
