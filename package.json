  "homepage": "https://synclair.dev",
  "scripts": {
    "dev": "synclair dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
