    "rank:hygiene": "synclair rank-hygiene",
    "draft:host-catalog": "synclair draft-host-catalog",
    "check:ux-docs": "synclair check-ux-docs",
    "scan:ux-coverage": "synclair scan-ux-coverage",
    "check:purity": "synclair check-foundation-purity",
    "check:pages": "synclair check-pages",
    "check:tiering": "synclair check-tiering",
    "check:recipes": "synclair check-recipes",
    "check:freshness": "synclair check-freshness",
    "refresh": "synclair refresh",
    "check:knowledge": "synclair check-knowledge",
    "check:knowledge-local": "synclair check-knowledge-local",
    "check:anchors": "synclair check-anchors",
    "check:rulings": "synclair check-rulings",
